TARGET_USER=bhupen07

# 采集结果默认保存目录
DATA_DIR=data

# 本地 Chrome 可执行文件路径（默认自动使用本机 Google Chrome）
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 本地 Chrome 会话数据保存目录（首次运行登录后，后续运行自动复用登录态）
CHROME_USER_DATA_DIR=.chrome_profile

# 代理（如系统已开启全局/TUN 代理可不填；如需单独指定则取消注释）
# PROXY=http://127.0.0.1:7890

# 本地浏览器是否使用无头模式（true / false，默认 false）
# HEADLESS=false
