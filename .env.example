TARGET_USER=bhupen07

# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 代理（国内必填）。格式：http://172.20.240.1:7897（WSL2 填 Windows 宿主机 IP）
PROXY=http://172.20.240.1:7897

# 方案 A：连接 Windows 上已有的 Chrome（远程调试模式）
# 在 Windows 运行：chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\ChromeDebug
# 然后取消下面这行的注释：
# CHROME_REMOTE_URL=172.20.240.1:9222
